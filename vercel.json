    {
      "path": "/api/email/process",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/integrations/xero/sync",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/agents/xero-watch",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/agents/doc-watch",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/agents/price-watch",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/agents/debtors-watch",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/agents/stock-cover",
      "schedule": "55 3 * * *"
    },
    {
      "path": "/api/agents/digest",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/agents/brief-notify",
      "schedule": "*/15 * * * *"
