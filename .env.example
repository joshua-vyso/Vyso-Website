# Phase 4 — search & AI-visibility (`.ai/plan_phase4_search_ai_visibility.md`,
# Workstream A). No file named `.env.example` existed before this phase; only
# the new vars this workstream introduced are documented here. See
# `docs/seo-operations.md` for how each one is used and how to generate it.
# Never commit real values for these — `.env.local` stays untracked.

# Google Search Console: Settings → Ownership verification → HTML tag →
# copy just the `content="…"` value (not the whole <meta> tag).
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools: Settings → site verification → HTML meta tag →
# copy just the `content="…"` value.
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow (https://www.indexnow.org): any UUID or 8-128 char hex string you
# generate yourself — it isn't issued by anyone, it just has to be unique and
# match the key file served at https://vyso.co.za/{key}.txt (see
# app/api/indexnow/key/route.ts + the next.config.ts rewrite). Generate one
# with, e.g., `openssl rand -hex 16`.
INDEXNOW_KEY=

# Shared secret for POST /api/indexnow — send it as the `x-indexnow-admin-token`
# header. Not a public/NEXT_PUBLIC_ var: this gates who can trigger a submission.
INDEXNOW_ADMIN_TOKEN=

# The agents (`/api/agents/price-watch`, `/api/agents/debtors-watch`,
# `/api/agents/stock-cover`, `/api/agents/doc-watch`, `/api/agents/xero-watch`,
# `/api/agents/digest`, `/api/agents/brief-notify` — all GET + `Authorization:
# Bearer $CRON_SECRET`).
#
# THEY RUN FOR EVERY ORGANISATION BY DEFAULT, and the three vars below only ever
# narrow that. Leave ALL THREE UNSET IN PRODUCTION. The org list comes from the
# `organisations` table, oldest first (lib/platform/agents/org-allowlist.ts).

# Comma-separated organisation uuids the agents must SKIP. The escape hatch for a
# churned or internal org, and the only one of these three production is ever
# expected to set. Normally empty.
AGENTS_ORG_EXCLUDE=

# OPTIONAL RESTRICTION — run ONLY these orgs. For a developer or a staging deploy
# pointed at a copy of production who wants one org's agents to run. SETTING THIS
# IN PRODUCTION TURNS THE AGENTS OFF FOR EVERY ORG IT DOES NOT NAME, silently, so
# production leaves it blank. Ids that match no organisation are reported as
# `notFound` in the run's JSON rather than run.
AGENTS_ORG_IDS=

# Price Watch's original name for the same optional restriction, read only when
# AGENTS_ORG_IDS is unset or blank. Kept so an old deploy behaves predictably;
# nothing new should set it, and production leaves it blank too.
PRICE_WATCH_ORG_IDS=

# --- Xero (the Plugins section, .ai/plan_plugins_xero.md) --------------------
#
# The OAuth app's credentials, from Xero's developer portal. Without ALL FIVE the
# plugin page says Xero is not configured and offers no Connect button; nothing
# else in the platform is affected.
#
# NOTE neither the nightly sync (`/api/integrations/xero/sync`, GET +
# `Authorization: Bearer $CRON_SECRET`, 03:20 UTC) nor Xero Watch
# (`/api/agents/xero-watch`, 03:30 UTC) needs a var of its own: the sync runs for
# every org that has CONNECTED Xero — the owner's consent in Xero IS the opt-in —
# and the agent runs for every organisation like every other agent, doing nothing
# for the ones with no connection row.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must be absolute and HTTPS (http:// is allowed only on localhost), and must
# match the redirect URI registered on the Xero app exactly.
XERO_REDIRECT_URI=

# Space-separated. Must include at least: offline_access accounting.invoices
# accounting.contacts accounting.settings.read accounting.payments.read
XERO_SCOPES=

# 32 bytes, base64 or hex — the AES-GCM key the server encrypts Xero access and
# refresh tokens with before they reach Postgres. Rotating it invalidates every
# stored token and every org has to reconnect.
XERO_TOKEN_ENCRYPTION_KEY=

# --- Microsoft 365 order inbox (Turn n Slice) -------------------------------
#
# Single-tenant Entra application credentials for the observational/read-only
# order-ingestion service. Mailbox access is granted and scoped in Exchange
# Online Application RBAC (`Application Mail.Read`), not with tenant-wide Graph
# Mail.Read. Do not add Mail.ReadWrite or Mail.Send for this integration.
ENTRA_APP_ID_TNS=
ENTRA_DIRECTORY_ID_TNS=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=orders@turnnslice.com
MICROSOFT_GRAPH_CLIENT_STATE=
MICROSOFT_GRAPH_WEBHOOK_URL=https://vyso.co.za/api/integrations/microsoft/webhook
# Trusted Vyso organisation UUID for this single mailbox. Never derive org_id
# from sender, subject, body, or any other Microsoft-controlled content.
MICROSOFT_GRAPH_ORG_ID=
# Default/current production mode. Do not change to rest_immutable_entry_id until
# the documented delete/recreate cutover is explicitly approved and coordinated.
MICROSOFT_GRAPH_ID_TYPE=rest_id

# Empty only while creating the first subscription: Microsoft must validate the
# deployed webhook before it returns an id. Once creation succeeds, store that id
# locally AND in Vercel and redeploy. Normal notifications fail closed while empty.
MICROSOFT_GRAPH_SUBSCRIPTION_ID=

# Development-only live check. Acquires an app token, reads five metadata-only
# Inbox records from MICROSOFT_MAILBOX, then verifies that
# joshua@turnnslice.com is rejected with HTTP 403. It logs neither credentials,
# tokens, message subjects, sender names, nor sender local parts.
#   npm run verify:microsoft-graph
#
# Subscription lifecycle (manual for this milestone; no scheduler yet):
#   npm run microsoft:subscription:init
#   npm run microsoft:subscription:create
#   npm run microsoft:subscription:inspect
#   npm run microsoft:subscription:renew

# Comma-separated recipients of the Monday digest. Unset ⇒ the digest route
# returns 503 and sends nothing — there is no default recipient on purpose, as a
# business's supplier prices must never be mailed to a hardcoded address.
# Also needs RESEND_API_KEY to be set for a send to happen.
PRICE_WATCH_DIGEST_TO=

# Model tiers (.ai/plan_brief_chat_v2.md §2.7/W0). Every var below is optional —
# each has a hardcoded default in code, listed here, and all defaults are cheap
# tiers on purpose. Set one only to override that specific call site; there is
# no single "use this model everywhere" switch, because the calls have very
# different cost/latency/quality needs.

# Finch chat (Q&A, analytics, parsing) — lib/ai/finch/config.ts. Default:
# claude-haiku-4-5.
ANTHROPIC_AGENT_MODEL=

# Finch workflow tier (multi-step actions, e.g. OrderFlow order-building) —
# lib/ai/finch/config.ts. Default: claude-sonnet-4-6.
ANTHROPIC_WORKFLOW_MODEL=

# Long-form / observation tier — lib/ai/anthropic.ts (runPrompt) and
# lib/ai/price-watch-model.ts (Price Watch observation text, the one agent
# output a human reads verbatim). Default: claude-sonnet-4-6. Set this to an
# Opus id only when a specific case has been deliberately chosen to need it —
# never leave it defaulting to Opus.
ANTHROPIC_MODEL=

# Document extraction (Doc-U) — lib/ai/anthropic.ts. High-volume + structured,
# so it stays on the fast/cheap tier. Default: claude-haiku-4-5.
# Covers INVOICES and STATEMENTS only: one supplier, no catalogue reasoning.
ANTHROPIC_EXTRACT_MODEL=

# Customer ORDER extraction (Doc-U) — lib/ai/anthropic.ts (extractOrderDocument).
# Scoped away from ANTHROPIC_EXTRACT_MODEL deliberately. An order is read against
# the org's catalogue — several hundred product names — so on top of transcribing
# a dense multi-page purchase order the model decides, per line, which product
# each row IS and which it merely resembles. Haiku read well and decided badly:
# on a three-page Bakubung Bush Lodge PO it filed "GRAPES WHITE" as a second
# Avocado, "Mix Vegetables" as Cabbage and "Sweet Corn" as Baby Sweet Corn, and
# the order invoiced at R25,958.95 against a paper total of R13,457.60.
# Orders are a low-volume path (a few dozen a day, not thousands), so the tier
# costs little in absolute terms and each error costs a wrong customer invoice.
# Default: claude-sonnet-4-6.
#
# NOTE this is now the FALLBACK reader, not the default one — see
# ORDER_EXTRACT_PROVIDER below. It is still what serves every PDF order and
# every OpenAI failure, so it is not decommissioned and should stay pointed at
# a model that can read a dense purchase order.
ANTHROPIC_ORDER_EXTRACT_MODEL=

# --- OpenAI (the ORDER lane only) -------------------------------------------
#
# WHAT THIS IS FOR. Order reading is the one place the Anthropic tiers have kept
# failing, and not on the characters: on a NebulaPOS purchase order Sonnet read
# "MUSHROOM GABLE 445.50" as "Mushroom Garlic Box 443", "BRINJALS" as "Cabbage",
# and paired an avocado row's bulk quantity with a cost printed per each ("4.00
# boxes @ 15.75 = R63" against a printed nett of R756). So the order lane gets a
# second reader to be measured against, and the reading and the MATCHING are
# split into two calls — a reader holding a catalogue in mind starts seeing
# catalogue words on the page.

# The API key. Server-only; never NEXT_PUBLIC. Get it from
# https://platform.openai.com/api-keys.
#
# MUST ALSO BE SET IN VERCEL (Project → Settings → Environment Variables) or the
# deployed order lane falls back to Anthropic on every single upload and stamps
# a warning on each document saying so.
OPENAI_API_KEY=

# Which provider reads customer ORDERS: "openai" (default) or "anthropic".
# Nothing else in the platform is affected — invoices, statements, summaries,
# categorisation, Price Watch and chat are all Anthropic regardless.
# Set to "anthropic" to put the order lane back exactly where 12ff849 left it.
ORDER_EXTRACT_PROVIDER=

# The OpenAI model that READS an order — lib/ai/order-reader.ts.
# Default: gpt-5.6-luna.
# NB the gpt-5.x family rejects `temperature` outright and requires
# `max_completion_tokens` in place of `max_tokens`; lib/ai/openai.ts sends
# neither of the rejected parameters, so a model id from this family is safe.
OPENAI_ORDER_MODEL=

# The OpenAI model that MATCHES each extracted line to a catalogue product —
# lib/ai/order-match-call.ts, a second and completely independent call over a
# shortlist. Default: gpt-5.6-luna. With no key, or on any failure, the
# deterministic matcher in lib/platform/docu/order-line-match.ts stands alone,
# exactly as it did before — the agent can only improve on it or be absent.
OPENAI_MATCH_MODEL=

# Doc-U operational summary (≤500 chars, not deep reasoning) —
# lib/ai/anthropic.ts. Default: claude-haiku-4-5.
ANTHROPIC_SUMMARY_MODEL=

# Product categorisation (label-per-name) — lib/ai/anthropic.ts. Default:
# claude-haiku-4-5.
ANTHROPIC_CATEGORISE_MODEL=

# Product-name matching (pick the right canonical from a short candidate
# list) — used by both lib/ai/anthropic.ts and lib/ai/price-watch-model.ts's
# Price Watch line-matching call. Default: claude-haiku-4-5.
ANTHROPIC_MATCH_MODEL=

# Price Watch observation transport override — lib/ai/price-watch-model.ts.
# Unset ⇒ falls back to ANTHROPIC_MODEL (see above), so overriding
# ANTHROPIC_MODEL already covers this unless observation specifically needs to
# diverge from the rest of the long-form tier.
ANTHROPIC_OBSERVE_MODEL=
