# Phase 4 — search & AI-visibility (`.ai/plan_phase4_search_ai_visibility.md`,
# Workstream A). No file named `.env.example` existed before this phase; only
# the new vars this workstream introduced are documented here. See
# `docs/seo-operations.md` for how each one is used and how to generate it.
# Never commit real values for these — `.env.local` stays untracked.

# Google Search Console: Settings → Ownership verification → HTML tag →
# copy just the `content="…"` value (not the whole <meta> tag).
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools: Settings → site verification → HTML meta tag →
# copy just the `content="…"` value.
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow (https://www.indexnow.org): any UUID or 8-128 char hex string you
# generate yourself — it isn't issued by anyone, it just has to be unique and
# match the key file served at https://vyso.co.za/{key}.txt (see
# app/api/indexnow/key/route.ts + the next.config.ts rewrite). Generate one
# with, e.g., `openssl rand -hex 16`.
INDEXNOW_KEY=

# Shared secret for POST /api/indexnow — send it as the `x-indexnow-admin-token`
# header. Not a public/NEXT_PUBLIC_ var: this gates who can trigger a submission.
INDEXNOW_ADMIN_TOKEN=

# The overnight agents (`/api/agents/price-watch`, `/api/agents/debtors-watch`,
# `/api/agents/stock-cover`, `/api/agents/doc-watch`, `/api/agents/digest` — all
# GET + `Authorization: Bearer $CRON_SECRET`). Opt-in by design — see
# `.ai/plan_price_watch_agent.md` and `.ai/plan_agents_phase_c.md`.

# Comma-separated organisation uuids EVERY agent runs for (Phase C: the one
# allowlist all five routes read, via lib/platform/agents/org-allowlist.ts).
# Unset or empty means the agents no-op (HTTP 200, `ran: 0`): defaulting to
# "every org" would write findings into customers' Briefs off data nobody has
# reviewed.
AGENTS_ORG_IDS=

# Price Watch's original name for the same list, still honoured as the FALLBACK
# when AGENTS_ORG_IDS is unset/empty — a deploy that already sets this keeps
# working untouched. Set AGENTS_ORG_IDS for anything new.
PRICE_WATCH_ORG_IDS=

# --- Xero (the Plugins section, .ai/plan_plugins_xero.md) --------------------
#
# The OAuth app's credentials, from Xero's developer portal. Without ALL FIVE the
# plugin page says Xero is not configured and offers no Connect button; nothing
# else in the platform is affected.
#
# NOTE the nightly sync (`/api/integrations/xero/sync`, GET + `Authorization:
# Bearer $CRON_SECRET`, 03:20 UTC) and Xero Watch (`/api/agents/xero-watch`,
# 03:30 UTC) need no allowlist of their own: the sync runs for every org that has
# CONNECTED Xero — the owner's consent in Xero IS the opt-in — while the agent
# reads AGENTS_ORG_IDS like every other agent, because it writes opinions.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must be absolute and HTTPS (http:// is allowed only on localhost), and must
# match the redirect URI registered on the Xero app exactly.
XERO_REDIRECT_URI=

# Space-separated. Must include at least: offline_access accounting.invoices
# accounting.contacts accounting.settings.read accounting.payments.read
XERO_SCOPES=

# 32 bytes, base64 or hex — the AES-GCM key the server encrypts Xero access and
# refresh tokens with before they reach Postgres. Rotating it invalidates every
# stored token and every org has to reconnect.
XERO_TOKEN_ENCRYPTION_KEY=

# Comma-separated recipients of the Monday digest. Unset ⇒ the digest route
# returns 503 and sends nothing — there is no default recipient on purpose, as a
# business's supplier prices must never be mailed to a hardcoded address.
# Also needs RESEND_API_KEY to be set for a send to happen.
PRICE_WATCH_DIGEST_TO=

# Model tiers (.ai/plan_brief_chat_v2.md §2.7/W0). Every var below is optional —
# each has a hardcoded default in code, listed here, and all defaults are cheap
# tiers on purpose. Set one only to override that specific call site; there is
# no single "use this model everywhere" switch, because the calls have very
# different cost/latency/quality needs.

# Finch chat (Q&A, analytics, parsing) — lib/ai/finch/config.ts. Default:
# claude-haiku-4-5.
ANTHROPIC_AGENT_MODEL=

# Finch workflow tier (multi-step actions, e.g. OrderFlow order-building) —
# lib/ai/finch/config.ts. Default: claude-sonnet-4-6.
ANTHROPIC_WORKFLOW_MODEL=

# Long-form / observation tier — lib/ai/anthropic.ts (runPrompt) and
# lib/ai/price-watch-model.ts (Price Watch observation text, the one agent
# output a human reads verbatim). Default: claude-sonnet-4-6. Set this to an
# Opus id only when a specific case has been deliberately chosen to need it —
# never leave it defaulting to Opus.
ANTHROPIC_MODEL=

# Document extraction (Doc-U) — lib/ai/anthropic.ts. High-volume + structured,
# so it stays on the fast/cheap tier. Default: claude-haiku-4-5.
ANTHROPIC_EXTRACT_MODEL=

# Doc-U operational summary (≤500 chars, not deep reasoning) —
# lib/ai/anthropic.ts. Default: claude-haiku-4-5.
ANTHROPIC_SUMMARY_MODEL=

# Product categorisation (label-per-name) — lib/ai/anthropic.ts. Default:
# claude-haiku-4-5.
ANTHROPIC_CATEGORISE_MODEL=

# Product-name matching (pick the right canonical from a short candidate
# list) — used by both lib/ai/anthropic.ts and lib/ai/price-watch-model.ts's
# Price Watch line-matching call. Default: claude-haiku-4-5.
ANTHROPIC_MATCH_MODEL=

# Price Watch observation transport override — lib/ai/price-watch-model.ts.
# Unset ⇒ falls back to ANTHROPIC_MODEL (see above), so overriding
# ANTHROPIC_MODEL already covers this unless observation specifically needs to
# diverge from the rest of the long-form tier.
ANTHROPIC_OBSERVE_MODEL=
